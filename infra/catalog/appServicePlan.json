    "check": "linuxPlanInRegion",
    "param": "<key>Name",
    "groupParam": "<key>Group",
    "kind": "appServicePlan",
    "role": "Linux plan the apps run on",
    "size": { "answer": "<key>Sku", "param": "<key>Sku", "label": "Size of <title>", "options": ["B1", "B2", "P0v3", "P1v3"], "default": "B1", "readCurrent": true },
    "cost": { "kind": "appServicePlan", "order": 1, "label": "App Service plan {name} ({size}, Linux, always on)", "sharedLabel": "App Service plan {name} (shared from {group})" }
  },
